# Elexon BMRS API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Day-Ahead Decision Cutoff Time in UTC (HH:MM)
# Options: 11:00 (Standard Elexon/National Grid DA), 09:50 (GB Auction Gate Closure), 12:00 (Noon Cutoff)
DEFAULT_CUTOFF_TIME=11:00

# Cache TTL in seconds (1 hour default)
CACHE_TTL_SECONDS=3600

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Request Timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Upstream Max Retries
MAX_RETRIES=3

# Host & Port for local development
HOST=0.0.0.0
PORT=8000
