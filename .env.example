# ==========================================
# Wind Intelligence Environment Configuration
# ==========================================

# Elexon BMRS API Endpoint
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Day-Ahead Wholesale Decision Gate Closure Cutoff (UTC)
# Presets: 11:00 (Standard Elexon), 09:50 (GB Auction Gate), 12:00 (Noon Cutoff)
DEFAULT_CUTOFF_TIME=11:00

# Backend In-Memory Cache TTL (in seconds)
CACHE_TTL_SECONDS=3600

# Upstream Request Timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30

# Max Upstream Retries with Exponential Backoff
MAX_RETRIES=3

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend API Base URL (empty for local dev / Docker proxy; set in Vercel to deployed backend)
VITE_API_BASE_URL=
